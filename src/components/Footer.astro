---
import { site } from '../data/site';
import SocialIcon from './SocialIcon.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__row">
    <span>&copy; {year} {site.name} · <a href="/how-its-made/">How this site was made</a></span>
    <span>
      {site.socials.map((social, i) => (
        <>
          <a class="social-link" href={social.url} target="_blank" rel="noopener noreferrer">
            {social.icon && <SocialIcon icon={social.icon} />}
            {social.label}
          </a>
          {i < site.socials.length - 1 && ' · '}
        </>
      ))}
      {site.socials.length > 0 && ' · '}
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </span>
  </div>
</footer>
