---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="About" description={`About ${site.name}.`}>
  <section class="container section entry">
    <p class="eyebrow">About</p>
    <h1>{site.name}</h1>

    <div class="entry-content">
      <!-- Edit this page directly to write your bio. -->
      <p>
        {site.about}
      </p>
      <p>
        Add a paragraph or two here about your background, how you work, and
        what you're currently focused on.
      </p>
    </div>
  </section>
</BaseLayout>
