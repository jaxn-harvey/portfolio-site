---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Blog" description="Updates and news.">
  <section class="container section">
    <h1>Blog</h1>
    <p>Updates, news, and short notes.</p>

    {posts.length > 0 ? (
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-list__item">
            <a class="post-list__link" href={`/blog/${post.id}/`}>
              <span class="post-list__title">{post.data.title}</span>
              <time class="post-list__date" datetime={post.data.date.toISOString()}>
                {post.data.dateLabel ?? post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
              </time>
            </a>
            {post.data.summary && <p class="post-list__summary">{post.data.summary}</p>}
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-state">No posts yet. Add a Markdown file to src/content/posts/.</p>
    )}
  </section>
</BaseLayout>
