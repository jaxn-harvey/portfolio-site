---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byNewestFirst, formatDate } from '../../utils/entries';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => byNewestFirst(a.data.date, b.data.date),
);
---

<BaseLayout title="Blog" description="Updates and news.">
  <section class="container section">
    <h1>Blog</h1>
    <p>Announcements, updates, and notes.</p>

    {posts.length > 0 ? (
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-list__item">
            <a class="post-list__link" href={`/blog/${post.id}/`}>
              <span class="post-list__title">{post.data.title}</span>
              {(() => {
                const shown =
                  post.data.dateLabel ??
                  formatDate(post.data.date, { year: 'numeric', month: 'long', day: 'numeric' });
                if (!shown) return null;
                // <time datetime> needs a machine-readable date; without one,
                // fall back to a plain span so the markup stays valid.
                return post.data.date ? (
                  <time class="post-list__date" datetime={post.data.date.toISOString()}>{shown}</time>
                ) : (
                  <span class="post-list__date">{shown}</span>
                );
              })()}
            </a>
            {post.data.summary && <p class="post-list__summary">{post.data.summary}</p>}
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-state">No posts yet. Add a Markdown file to src/content/posts/.</p>
    )}
  </section>
</BaseLayout>
