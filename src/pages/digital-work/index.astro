---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DirectoryCard from '../../components/DirectoryCard.astro';
import { sections } from '../../data/site';
import { resolveAsset } from '../../utils/images';

const section = sections.find((s) => s.slug === 'digital-work')!;
---

<BaseLayout title="Digital Work" description={section.description}>
  <section class="container section">
    <a class="back-link" href="/portfolio/">&larr; Portfolio</a>
    <p class="eyebrow">Portfolio</p>
    <h1>{section.title}</h1>
    <p>{section.description}</p>

    <div class="card-grid">
      {section.subsections?.map((sub) => (
        <DirectoryCard href={sub.href} title={sub.title} description={sub.description} image={resolveAsset(sub.image)} />
      ))}
    </div>
  </section>
</BaseLayout>
