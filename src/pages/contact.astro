---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { site } from '../data/site';
---

<BaseLayout title="Contact" description={`Get in touch with ${site.name}.`}>
  <section class="container section entry">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch</h1>
    <p>You can reach me by email or through LinkedIn.</p>

    <div class="contact-links">
      <a class="btn btn--primary" href={`mailto:${site.email}`}>{site.email}</a>
      {site.socials.map((s) => (
        <a class="btn" href={s.url} target="_blank" rel="noopener noreferrer">
          {s.icon && <SocialIcon icon={s.icon} />}
          {s.label}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
