---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="Contact" description={`Get in touch with ${site.name}.`}>
  <section class="container section entry">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch</h1>
    <p>You can reach me by email.</p>

    <p>
      <a class="btn btn--primary" href={`mailto:${site.email}`}>{site.email}</a>
    </p>

    {site.socials.length > 0 && (
      <p class="post-list__summary">
        Or find me on {site.socials.map((s, i) => (
          <>
            <a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
            {i < site.socials.length - 1 && ', '}
          </>
        ))}.
      </p>
    )}
  </section>
</BaseLayout>
