---
import BaseLayout from './BaseLayout.astro';
import { Image } from 'astro:assets';
import { formatDate } from '../utils/entries';

interface Props {
  title: string;
  summary?: string;
  date?: Date;
  dateLabel?: string;
  cover?: import('astro').ImageMetadata;
  coverAlt?: string;
  tags?: string[];
}

const { title, summary, date, dateLabel, cover, coverAlt = '', tags = [] } = Astro.props;

// dateLabel wins if set; otherwise format `date`; if neither, show nothing.
const formattedDate =
  dateLabel ?? formatDate(date, { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={`${title} · Portfolio`} description={summary ?? title}>
  <div class="container section entry">
    <a class="back-link" href="/blog/">&larr; Blog</a>

    <header class="entry-header">
      {formattedDate && <p class="eyebrow">{formattedDate}</p>}
      <h1>{title}</h1>
      {tags.length > 0 && (
        <div class="card__tags" style="margin-bottom: 1.5rem;">
          {tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>

    {cover && <Image class="entry-cover" src={cover} alt={coverAlt} width={1600} />}

    <div class="entry-content">
      <slot />
    </div>
  </div>
</BaseLayout>
